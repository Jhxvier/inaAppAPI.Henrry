@using InaApp.ProyectoINAApp.Models.Factura
@model FacturaCreateViewModel

@{
    ViewData["Title"] = "Crear Factura";
}

<div class="container mt-4">
    <h2>Crear Factura</h2>

    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="card mb-4">
            <div class="card-header bg-info text-white">Información de la factura</div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label class="form-label" for="numeroFactura">Número de factura</label>
                        <input id="numeroFactura" class="form-control" value="Se asignará automáticamente al guardar" readonly aria-describedby="numeroFacturaAyuda" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="Fecha" class="form-label"></label>
                        <input asp-for="Fecha" class="form-control" />
                        <span asp-validation-for="Fecha" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="ClienteId" class="form-label">Cliente</label>
                        <select asp-for="ClienteId" asp-items="Model.Clientes" class="form-select">
                            <option value="">Seleccione un cliente</option>
                        </select>
                        <span asp-validation-for="ClienteId" class="text-danger"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header bg-info text-white">Agregar producto</div>
            <div class="card-body">
                <div class="row align-items-end">
                    <div class="col-md-6 mb-3">
                        <label asp-for="ProductoSeleccionadoId" class="form-label">Producto</label>
                        <select asp-for="ProductoSeleccionadoId" asp-items="Model.Productos" class="form-select">
                            <option value="">Seleccione un producto</option>
                        </select>
                    </div>
                    <div class="col-md-3 mb-3">
                        <label asp-for="Cantidad" class="form-label">Cantidad</label>
                        <input asp-for="Cantidad" type="number" min="1" class="form-control" />
                    </div>
                    <div class="col-md-3 mb-3">
                        <button type="submit"
                                asp-action="AgregarProducto"
                                formnovalidate
                                class="btn btn-primary">
                            Agregar producto
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <h4>Detalle de la factura</h4>
        <table class="table table-bordered table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Producto</th>
                    <th>Cantidad</th>
                    <th>Precio unitario</th>
                    <th>Subtotal</th>
                    <th>Impuesto</th>
                    <th>Total de línea</th>
                    <th class="text-center">Acción</th>
                </tr>
            </thead>
            <tbody id="detalles">
                @for (var indice = 0; indice < Model.Detalles.Count; indice++)
                {
                    <tr>
                        <td>
                            @Model.Detalles[indice].Producto
                            <input asp-for="Detalles[indice].ProductoId" type="hidden" />
                            <input asp-for="Detalles[indice].Producto" type="hidden" />
                            <input asp-for="Detalles[indice].Cantidad" type="hidden" />
                            <input asp-for="Detalles[indice].PrecioUnitario" type="hidden" />
                        </td>
                        <td>@Model.Detalles[indice].Cantidad</td>
                        <td>₡@Model.Detalles[indice].PrecioUnitario.ToString("N2")</td>
                        <td>₡@Model.Detalles[indice].Subtotal.ToString("N2")</td>
                        <td>₡@Model.Detalles[indice].Impuesto.ToString("N2")</td>
                        <td>₡@Model.Detalles[indice].TotalLinea.ToString("N2")</td>
                        <td class="text-center">
                            <button type="submit"
                                    asp-action="EliminarProducto"
                                    name="indice"
                                    value="@indice"
                                    formnovalidate
                                    class="btn btn-danger btn-sm">
                                Eliminar
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="row justify-content-end">
            <div class="col-md-4">
                <div class="card mb-3">
                    <div class="card-header">Resumen</div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label asp-for="Descuento" class="form-label"></label>
                            <input asp-for="Descuento" type="number" min="0" step="0.01" class="form-control" />
                            <span asp-validation-for="Descuento" class="text-danger"></span>
                            <button type="submit"
                                    asp-action="ActualizarTotales"
                                    formnovalidate
                                    class="btn btn-outline-primary btn-sm mt-2">
                                Actualizar totales
                            </button>
                        </div>
                        <p><strong>Subtotal:</strong> ₡@Model.Subtotal.ToString("N2")</p>
                        <p><strong>Impuesto:</strong> ₡@Model.Impuesto.ToString("N2")</p>
                        <h4>Total: ₡@Model.Total.ToString("N2")</h4>
                    </div>
                </div>
            </div>
        </div>

        <button type="submit" class="btn btn-success">Guardar factura</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}