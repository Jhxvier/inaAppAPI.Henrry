@using InaApp.ProyectoINAApp.Models.Producto

@model ProductoEditViewModel

@{
    ViewData["Title"] = "Modificar Producto";
}

<div class="container mt-4">
    <h2>Modificar Producto</h2>
    <form asp-action="Edit" method="post">
        <input asp-for="Id" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <div class="row">
            <div class="col-md-3 mb-3"><label asp-for="Codigo"></label><input asp-for="Codigo" class="form-control" /></div>
            <div class="col-md-3 mb-3"><label asp-for="ImpuestoAplicable"></label><select asp-for="ImpuestoAplicable" asp-items="Html.GetEnumSelectList<inaApp.Common.Enums.Enums.TipoImpuesto>()" class="form-select"></select></div>
            <div class="col-md-3 mb-3"><label asp-for="PorcentajeImpuesto"></label><input asp-for="PorcentajeImpuesto" type="number" min="0" max="100" step=".01" class="form-control" /></div>
            <div class="col-md-3 mb-3"><label asp-for="DescuentoMaximo"></label><input asp-for="DescuentoMaximo" type="number" min="0" max="100" step=".01" class="form-control" /></div>
        </div>
        <div class="mb-3">
            <label asp-for="Nombre" class="form-label"></label>
            <input asp-for="Nombre" class="form-control" />
            <span asp-validation-for="Nombre" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Descripcion" class="form-label"></label>
<textarea asp-for="Descripcion" class="form-control"></textarea>
            <span asp-validation-for="Descripcion" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Precio" class="form-label"></label>
            <input asp-for="Precio" class="form-control" />
            <span asp-validation-for="Precio" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Stock" class="form-label"></label>
            <input asp-for="Stock" class="form-control" />
            <span asp-validation-for="Stock" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="CategoriaProductoId" class="form-label"></label>
            <select asp-for="CategoriaProductoId" asp-items="Model.Categorias" class="form-select">
                <option value="">Seleccione una categoría</option>
            </select>
            <span asp-validation-for="CategoriaProductoId" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-success">
            Guardar cambios
        </button>
        <a asp-action="Index" class="btn btn-secondary">
            Cancelar
        </a>
    </form>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
