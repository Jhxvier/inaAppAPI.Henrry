@{
    ViewData["Title"] = "Detalles de la Factura";
}

<div class="container mt-4">
    <h2>Detalles de la Factura</h2>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success">@TempData["Mensaje"]</div>
    }

    <div class="card mt-3">
        <div class="card-header bg-info text-white">Información general</div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-4"><p><strong>Número:</strong> @Model.NumeroFactura</p></div>
                <div class="col-md-4"><p><strong>Fecha:</strong> @Model.Fecha.ToString("dd/MM/yyyy")</p></div>
                <div class="col-md-4"><p><strong>Estado:</strong> @(Model.Estado ? "Activa" : "Inactiva")</p></div>
            </div>
            <p><strong>Cliente:</strong> @Model.Cliente</p>
            <p><strong>Tipo de documento:</strong> @Model.TipoDocumento</p>
        </div>
    </div>

    <h4 class="mt-4">Productos facturados</h4>
    <table class="table table-bordered table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Producto</th>
                <th>Cantidad</th>
                <th>Precio unitario</th>
                <th>Subtotal</th>
                <th>Impuesto aplicado</th>
                <th>Descuento</th>
                <th>Total de línea</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var detalle in Model.Detalles)
            {
                <tr>
                    <td>@detalle.Producto</td>
                    <td>@detalle.Cantidad</td>
                    <td>₡@detalle.PrecioUnitario.ToString("N2")</td>
                    <td>₡@detalle.Subtotal.ToString("N2")</td>
                    <td>@detalle.PorcentajeImpuesto.ToString("N2")% (₡@detalle.Impuesto.ToString("N2"))</td>
                    <td>@detalle.PorcentajeDescuento.ToString("N2")% (₡@detalle.Descuento.ToString("N2"))</td>
                    <td>₡@detalle.TotalLinea.ToString("N2")</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="card">
        <div class="card-header">Totales</div>
        <div class="card-body text-end">
            <p><strong>Subtotal:</strong> ₡@Model.Subtotal.ToString("N2")</p>
            <p><strong>Impuesto:</strong> ₡@Model.Impuesto.ToString("N2")</p>
            <p><strong>Descuento:</strong> ₡@Model.Descuento.ToString("N2")</p>
            <h4>Total final: ₡@Model.Total.ToString("N2")</h4>
        </div>
    </div>

    <div class="mt-3">
        <a asp-action="Index" class="btn btn-secondary">Volver</a>
        @if (Model.PuedeEmitirNotaCredito)
        {
            <a asp-action="NotaCredito" asp-route-id="@Model.Id" class="btn btn-warning">Generar nota de crédito</a>
        }
    </div>
</div>
