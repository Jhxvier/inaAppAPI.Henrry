@model InaApp.ProyectoINAApp.Models.Factura.FacturaCreateViewModel

<div class="modal fade" id="productosModal" tabindex="-1" aria-labelledby="productosModalTitulo" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header"><h5 id="productosModalTitulo">Buscar producto</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button></div>
            <div class="modal-body">
                <div class="row mb-2">
                    <div class="col"><input class="form-control filtro-popup" data-tabla="productosBody" data-campo="codigo" placeholder="Filtrar por código"></div>
                    <div class="col"><input class="form-control filtro-popup" data-tabla="productosBody" data-campo="nombre" placeholder="Filtrar por nombre"></div>
                </div>
                <table class="table">
                    <thead><tr><th>Código</th><th>Nombre</th><th>Categoría</th><th>Precio</th><th>Impuesto</th><th>Existencias</th><th></th></tr></thead>
                    <tbody id="productosBody">
                        @foreach (var producto in Model.ProductosDisponibles)
                        {
                            <tr data-codigo="@producto.Codigo.ToLowerInvariant()" data-nombre="@producto.Nombre.ToLowerInvariant()"><td>@producto.Codigo</td><td>@producto.Nombre</td><td>@producto.Categoria</td><td>₡@producto.Precio.ToString("N2")</td><td>@producto.Impuesto (@producto.PorcentajeImpuesto.ToString("N2") %)</td><td>@producto.Stock</td><td><button type="submit" asp-action="AgregarProducto" name="ProductoSeleccionadoId" value="@producto.Id" formnovalidate class="btn btn-sm btn-primary" disabled="@(producto.Stock <= 0)">Agregar</button></td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
