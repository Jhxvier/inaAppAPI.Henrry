@using InaApp.ProyectoINAApp.Models.Producto
@model ProductoIndexViewModel

@{
    ViewData["Title"] = "Detalles del Producto";
}

<div class="container mt-4">
    <h2>Detalles del Producto</h2>

    <div class="card mt-3">
        <div class="card-header bg-info text-white">
            Información del producto
        </div>
        <div class="card-body">
            <p><strong>Código:</strong> @Model.Codigo</p>
            <p><strong>Nombre:</strong> @Model.Nombre</p>
            <p><strong>Descripción:</strong> @Model.Descripcion</p>
            <p><strong>Precio:</strong> ₡@Model.Precio.ToString("N2")</p>
            <p><strong>Stock:</strong> @Model.Stock</p>
            <p><strong>Categoría:</strong> @Model.CategoriaProductoNombre</p>
            <p><strong>Impuesto:</strong> @Model.ImpuestoAplicable (@Model.PorcentajeImpuesto.ToString("N2") %)</p>
            <p><strong>Descuento máximo permitido:</strong> @Model.DescuentoMaximo.ToString("N2") %</p>
        </div>
    </div>

    <div class="mt-3">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
            Modificar
        </a>
        <a asp-action="Index" class="btn btn-secondary">
            Volver
        </a>
    </div>
</div>
